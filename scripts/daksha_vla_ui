#!/usr/bin/env python3

import os
import sys
from pathlib import Path


project_root = Path(os.environ.get("DAKSHA_PROJECT_ROOT", "")).expanduser()
if not project_root.is_absolute() or not (project_root / "app.py").is_file():
    raise SystemExit(
        "Set DAKSHA_PROJECT_ROOT to the lerobot_2 checkout containing app.py, ui/, and lerobot/."
    )

sys.path.insert(0, str(project_root.resolve()))

from app import main


main()
